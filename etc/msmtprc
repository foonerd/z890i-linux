# /etc/msmtprc  (root:root 0600). System-wide msmtp configuration: every local "sendmail" call goes to the relay.
defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log
aliases        /etc/aliases

account        wowcloud
host           <smtp-relay-host>
port           587
from           <alert-mailbox>
user           <alert-mailbox>
passwordeval   "cat /etc/msmtp-password"

account default : wowcloud
