# <file system>                                             <mount point> <type> <options>               <dump> <pass>
/dev/disk/by-uuid/<root-uuid>                               /             ext4   defaults                0      1
/dev/disk/by-uuid/<esp-uuid>                                /boot/efi     vfat   defaults                0      1
/swap.img                                                   none          swap   sw                      0      0
# The mirror. nofail: the system boots even if md0 is absent. No x-gvfs-show: the file manager must not offer to unmount it.
/dev/disk/by-uuid/<md0-filesystem-uuid>                     /volume1      ext4   defaults,nofail,discard 0      0
